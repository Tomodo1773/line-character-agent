# 日記管理 UI（src/webui）の環境変数

# Cosmos DB のアカウント URL
COSMOS_DB_ACCOUNT_URL=https://<cosmos-account>.documents.azure.com:443/
# 日記の持ち主（LINE ユーザ ID）
DIARY_USER_ID=U0000000000000000000000000000000

# UI の Basic 認証
ADMIN_USER=admin
ADMIN_PASSWORD=

# Cosmos DB への接続に使うサービスプリンシパル（ACA Express のみ）。
# ローカルでは `az login` した資格情報が使われるため設定不要。
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
