# Foundry プロジェクト（azd provision の出力から取得）
FOUNDRY_PROJECT_ENDPOINT=https://<foundry-account>.services.ai.azure.com/api/projects/<project>
AZURE_AI_MODEL_DEPLOYMENT_NAME=Kimi-K2.6
# 呼び出すホステッドエージェント名（azure.yaml の services.agent.name と一致させる）
HOSTED_AGENT_NAME=character-agent

# Cosmos DB / Storage
# いずれもマネージドIDで接続する。ローカルでは az login のログインユーザの権限が使われる
COSMOS_DB_ACCOUNT_URL=https://<cosmos-account>.documents.azure.com:443/
STORAGE_ACCOUNT_NAME=<storage-account>
LINE_MESSAGE_QUEUE_NAME=line-messages
DIARY_BACKUP_CONTAINER_NAME=diary-backup

# 日記の持ち主の LINE ユーザ ID。日次バックアップが失敗したときの push 通知先。
# インフラの出力ではないため `azd env set DIARY_USER_ID <LINE ユーザ ID>` で設定する
DIARY_USER_ID=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# LINE（ADR-0001 で Key Vault に残す唯一のシークレット）
LINE_CHANNEL_SECRET=...
LINE_CHANNEL_ACCESS_TOKEN=...

# 監視（Foundry Observability と同じ Application Insights に送る）
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...
