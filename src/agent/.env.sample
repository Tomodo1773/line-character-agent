# ローカルで `azd ai agent run` を使わずに直接起動する場合のみ必要。
# デプロイ後はホステッドエージェントのランタイムが自動注入するため設定不要。

# Foundry プロジェクトのエンドポイント（bicep の FOUNDRY_PROJECT_ENDPOINT 出力と同じ値）
FOUNDRY_PROJECT_ENDPOINT="https://YOUR_ACCOUNT.services.ai.azure.com/api/projects/YOUR_PROJECT"

# 使用するモデルのデプロイ名（bicep の chatDeploymentName と同じ値）
AZURE_AI_MODEL_DEPLOYMENT_NAME="Kimi-K2.6"

# 任意: 設定すると Application Insights へ OpenTelemetry トレースを送出する
# APPLICATIONINSIGHTS_CONNECTION_STRING="InstrumentationKey=..."
