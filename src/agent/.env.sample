# ローカルで `azd ai agent run` を使わずに直接起動する場合のみ必要。
# FOUNDRY_PROJECT_ENDPOINT はデプロイ後にランタイムが自動注入する。
# それ以外は azure.yaml の services.agent.env でコンテナに渡す。

# Foundry プロジェクトのエンドポイント（bicep の FOUNDRY_PROJECT_ENDPOINT 出力と同じ値）
FOUNDRY_PROJECT_ENDPOINT="https://YOUR_ACCOUNT.services.ai.azure.com/api/projects/YOUR_PROJECT"

# 使用するモデルのデプロイ名（bicep の chatDeploymentName と同じ値）
AZURE_AI_MODEL_DEPLOYMENT_NAME="Kimi-K2.6"

# 日記の埋め込みに使うデプロイ名（bicep の embeddingDeploymentName と同じ値）
AZURE_AI_EMBEDDING_DEPLOYMENT_NAME="text-embedding-3-small"

# 日記とプロフィールを置く Cosmos DB（マネージドIDで接続する。ローカルでは az login のユーザ権限）
COSMOS_DB_ACCOUNT_URL="https://YOUR_ACCOUNT.documents.azure.com:443/"

# 日記とプロフィールの持ち主の LINE ユーザ ID（Cosmos DB のパーティションキーに使う値）
# インフラの出力ではないため `azd env set DIARY_USER_ID <LINE ユーザ ID>` で設定する
DIARY_USER_ID="Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# 任意: 設定すると Application Insights へ OpenTelemetry トレースを送出する
# APPLICATIONINSIGHTS_CONNECTION_STRING="InstrumentationKey=..."

# 評価（`uv run python -m evals.run_eval`）でのみ使う採点役モデルのデプロイ名。
# エージェントのランタイムでは読まないため、bicep の appSettings には追加しない（詳細は evals/README.md）
# EVAL_JUDGE_DEPLOYMENT_NAME="gpt-4.1-mini"
